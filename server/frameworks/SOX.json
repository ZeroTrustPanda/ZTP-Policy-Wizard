      "id": "cis",
      "title": "CIS Critical Security Controls v8.1 (Safeguards 9.2 DNS filtering, 9.3 URL filters, 9.6 block unnecessary file types, 10.1 anti-malware, 3.13 DLP)",
      "url": "https://myctrl.tools/frameworks/cis-controls-v8"
    }
  ],
  "controls": [
    {
      "id": "§302",
      "name": "Corporate responsibility for financial reports",
      "source": "sox"
    },
    {
      "id": "§404",
      "name": "Management assessment of internal controls",
      "source": "sox"
    },
    {
      "id": "AS2201-ITGC",
      "name": "IT general controls supporting ICFR (access, change, operations)",
      "source": "pcaob2201"
    }
  ],
  "areas": {
    "urlFiltering": {
      "controls": [
        "§404",
        "AS2201-ITGC"
      ],
      "rationale": "Protect financial systems from web-borne threats."
    },
    "cloudAppControl": {
      "controls": [
        "§404",
        "AS2201-ITGC"
      ],
      "rationale": "Control financial data in unsanctioned cloud apps."
    },
    "fileTypeControl": {
      "controls": [
        "§404",
        "AS2201-ITGC"
      ],
      "rationale": "Block malware delivery file types."
    },
    "advancedThreatProtection": {
      "controls": [
        "§404",
        "AS2201-ITGC"
      ],
      "rationale": "Protect integrity of financial systems."
    },
    "firewallFiltering": {
      "controls": [
        "§404",
        "AS2201-ITGC"
      ],
      "rationale": "Restrict outbound connectivity."
    },
    "dnsSecurity": {
      "controls": [
        "§404",
        "AS2201-ITGC"
      ],
      "rationale": "DNS-layer protection."
    },
    "sslInspection": {
      "controls": [
        "§404",
        "AS2201-ITGC"
      ],
      "rationale": "Inspect TLS; exempt banking and health sites for privacy."
    },
    "dlpMonitor": {
      "controls": [
        "§404",
        "AS2201-ITGC"
      ],
      "rationale": "Log movement of financial statements and MNPI."
    },
    "dlpBlock": {
      "controls": [
        "§404",
        "AS2201-ITGC"
      ],
      "rationale": "Block MNPI and financial statement leakage before disclosure."
    },
    "endpointDlp": {
      "controls": [
        "§404",
        "AS2201-ITGC"
      ],
      "rationale": "Monitor financial data copied to removable media, cloud sync and print."
    },
    "sandbox": {
      "controls": [
        "§404",
        "AS2201-ITGC"
      ],
      "rationale": "Detonate unknown files."
    },
    "aiPromptCapture": {
      "controls": [
        "§404",
        "AS2201-ITGC"
      ],
      "rationale": "Capture GenAI prompts that may contain unreleased financial data."
    }
  },
  "dlp": {
    "monitorEngines": [
      "GLBA",
      "PCI"
    ],
    "blockRules": [
      {
        "key": "Financial-Statements",
        "label": "Financial-Statements",
        "dictionaries": [
          "predefined:FINANCIAL",
          "custom:MNPI"
        ],
        "controls": [
          "§302"
        ]
      },
      {
        "key": "Bank-Routing",
        "label": "Bank-Routing",
        "dictionaries": [
          "predefined:ABA_LEAKAGE",
          "predefined:CREDIT_CARD"
        ],
        "controls": [
          "§404"
        ]
      },
      {
        "key": "Source-Code",
        "label": "Source-Code",
        "defaultAction": "ALLOW",
        "severity": "RULE_SEVERITY_MEDIUM",
        "why": "Program source (structure and statements together) leaving the organization, for example pasted into AI apps or personal repositories. Monitor by default.",
        "dictionaries": [
          "custom:SRC_SIGNAL",
          "custom:SRC_ANCHOR"
        ],
        "expression": "(({SRC_SIGNAL} > 4) AND ({SRC_ANCHOR} > 0))",
        "controls": [
          "§302"
        ]
      }
    ],
    "endpointChannels": [
      "REMOVABLE_DRIVE_TRANSFER",
      "PERSONAL_CLOUD_STORAGE",
      "PRINTING"
    ]
  },
  "objectives": {
