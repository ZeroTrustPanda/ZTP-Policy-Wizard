  "dlp": {
    "monitorEngines": [
      "HIPAA",
      "PCI",
      "GLBA"
    ],
    "blockRules": [
      {
        "key": "CUI-Markings",
        "label": "CUI-Markings",
        "dictionaries": [
          "custom:CUI_MARKINGS",
          "custom:CUI_LEGACY",
          "custom:CUI_DECONTROL"
        ],
        "controls": [
          "03.01.03"
        ],
        "expression": "((({CUI_MARKINGS} > 0) OR ({CUI_LEGACY} > 0)) AND NOT ({CUI_DECONTROL} > 0))",
        "why": "CUI and legacy markings (FOUO, LES, SBU, distribution statements B to F), except documents marked as decontrolled."
      },
      {
        "key": "PII",
        "label": "PII",
        "dictionaries": [
          "predefined:SSN",
          "predefined:TIN_LEAKAGE"
        ],
        "controls": [
          "03.01.03"
        ]
      },
      {
        "key": "Credentials",
        "label": "Credentials",
        "dictionaries": [
          "predefined:CRED_LEAKAGE",
          "custom:SECRETS_KEYS"
        ],
        "controls": [
          "03.01.03"
        ],
        "expression": "(({CRED_LEAKAGE} > 1) OR ({SECRETS_KEYS} > 0))",
        "why": "Passwords in clear text, private keys and cloud or SaaS access tokens."
      },
      {
        "key": "Source-Code",
        "label": "Source-Code",
        "defaultAction": "ALLOW",
        "severity": "RULE_SEVERITY_MEDIUM",
        "why": "Program source (structure and statements together) leaving the organization, for example pasted into AI apps or personal repositories. Monitor by default.",
        "dictionaries": [
          "custom:SRC_SIGNAL",
          "custom:SRC_ANCHOR"
        ],
        "expression": "(({SRC_SIGNAL} > 4) AND ({SRC_ANCHOR} > 0))",
        "controls": [
          "03.01.03"
        ]
      }
    ],
    "endpointChannels": [
      "REMOVABLE_DRIVE_TRANSFER",
      "PERSONAL_CLOUD_STORAGE",
      "PRINTING"
    ]
  },
