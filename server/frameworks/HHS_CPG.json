  "areas": {
    "urlFiltering": {
      "controls": [
        "N6",
        "E2"
      ],
      "rationale": "Block malicious, phishing and high-risk categories; restrict web destinations that expose ePHI to unauthorized parties."
    },
    "cloudAppControl": {
      "controls": [
        "E10",
        "N7"
      ],
      "rationale": "Control file-sharing, webmail and AI apps where ePHI can leave the organization."
    },
    "fileTypeControl": {
      "controls": [
        "N6"
      ],
      "rationale": "Block executable and script downloads from untrusted sources."
    },
    "advancedThreatProtection": {
      "controls": [
        "N6",
        "E1"
      ],
      "rationale": "Botnet, phishing, malicious content and cryptomining protections guard ePHI integrity."
    },
    "firewallFiltering": {
      "controls": [
        "N7"
      ],
      "rationale": "Restrict outbound protocols and tunnels that bypass inspection."
    },
    "dnsSecurity": {
      "controls": [
        "N6"
      ],
      "rationale": "Block DNS resolution of malicious and newly registered domains; stop DNS tunneling."
    },
    "sslInspection": {
      "controls": [
        "N6",
        "E5"
      ],
      "rationale": "Inspect encrypted traffic so malware and ePHI exfiltration controls work; exempt health and finance sites for privacy."
    },
    "dlpMonitor": {
      "controls": [
        "N8"
      ],
      "rationale": "Monitor-only DLP gives visibility into ePHI in motion without disrupting care workflows."
    },
    "dlpBlock": {
      "controls": [
        "E5",
        "N6"
      ],
      "rationale": "Block ePHI identifiers (SSN, MBI, MRN, ICD-10 with diagnosis context, NPI) leaving to unsanctioned destinations."
    },
    "endpointDlp": {
      "controls": [
        "N1"
      ],
      "rationale": "Monitor ePHI copied to USB storage, personal cloud sync and printers (device and media controls)."
    },
    "sandbox": {
      "controls": [
        "N6"
      ],
      "rationale": "Detonate unknown files before delivery; quarantine high-risk types."
    },
    "aiPromptCapture": {
      "controls": [
        "N8",
        "E10"
      ],
      "rationale": "Record GenAI prompts so PHI shared with AI tools is auditable."
    }
  },
  "dlp": {
    "monitorEngines": [
      "HIPAA",
      "PCI"
    ],
    "blockRules": [
      {
        "key": "PHI-Identifiers",
        "label": "PHI-Identifiers",
        "dictionaries": [
          "predefined:SSN",
          "custom:MBI",
          "custom:MRN"
        ],
        "controls": [
          "E5",
          "N6"
        ]
      },
      {
        "key": "PHI-Clinical",
        "label": "PHI-Clinical",
        "dictionaries": [
          "predefined:MEDICAL",
          "custom:ICD10",
          "predefined:NPI_LEAKAGE"
        ],
        "controls": [
          "E5",
          "N6"
        ]
      },
      {
        "key": "Payment-Cards",
        "label": "Payment-Cards",
        "dictionaries": [
          "predefined:CREDIT_CARD"
        ],
        "controls": [
          "E5",
          "N6"
        ]
      },
      {
        "key": "PHI-Sensitive",
        "label": "PHI-Sensitive",
        "why": "A specially protected condition (substance use, HIV, psychotherapy, genetic) together with a patient identifier.",
        "dictionaries": [
          "custom:PHI_SENSITIVE",
          "custom:MRN",
          "custom:DOB_LABEL",
          "custom:MBI",
          "custom:HEALTH_PLAN_ID"
        ],
        "expression": "(({PHI_SENSITIVE} > 0) AND (({MRN} > 0) OR ({DOB_LABEL} > 0) OR ({MBI} > 0) OR ({HEALTH_PLAN_ID} > 0)))",
        "controls": [
          "E5",
          "N6"
        ]
      },
      {
        "key": "PHI-Narrative",
        "label": "PHI-Narrative",
        "why": "Clinical note wording together with a patient identifier (discharge summaries, progress notes).",
        "dictionaries": [
          "custom:CLINICAL_NOTES",
          "custom:MRN",
          "custom:DOB_LABEL",
          "custom:HEALTH_PLAN_ID"
        ],
        "expression": "(({CLINICAL_NOTES} > 2) AND (({MRN} > 0) OR ({DOB_LABEL} > 0) OR ({HEALTH_PLAN_ID} > 0)))",
        "controls": [
          "E5",
          "N6"
        ]
      },
      {
        "key": "PHI-Bulk",
        "label": "PHI-Bulk",
        "why": "Fifty or more patient identifiers in one transfer: a bulk export, whatever the destination.",
        "dictionaries": [
          "custom:MRN",
          "custom:MBI",
          "predefined:SSN",
          "custom:DOB_LABEL"
        ],
        "expression": "(({MRN} > 49) OR ({MBI} > 49) OR ({SSN} > 49) OR ({DOB_LABEL} > 49))",
        "controls": [
          "E5",
          "N6"
        ]
      }
    ],
    "endpointChannels": [
      "REMOVABLE_DRIVE_TRANSFER",
      "PERSONAL_CLOUD_STORAGE",
      "PRINTING"
    ]
  },
