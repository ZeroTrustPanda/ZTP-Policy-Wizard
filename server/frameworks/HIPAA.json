  "areas": {
    "urlFiltering": {
      "controls": [
        "164.308(a)(5)(ii)(B)",
        "164.312(a)(1)"
      ],
      "rationale": "Block malicious, phishing and high-risk categories; restrict web destinations that expose ePHI to unauthorized parties."
    },
    "cloudAppControl": {
      "controls": [
        "164.312(a)(1)",
        "164.312(e)(1)"
      ],
      "rationale": "Control file-sharing, webmail and AI apps where ePHI can leave the organization."
    },
    "fileTypeControl": {
      "controls": [
        "164.308(a)(5)(ii)(B)"
      ],
      "rationale": "Block executable and script downloads from untrusted sources."
    },
    "advancedThreatProtection": {
      "controls": [
        "164.308(a)(5)(ii)(B)",
        "164.312(c)(1)"
      ],
      "rationale": "Botnet, phishing, malicious content and cryptomining protections guard ePHI integrity."
    },
    "firewallFiltering": {
      "controls": [
        "164.312(a)(1)",
        "164.312(e)(1)"
      ],
      "rationale": "Restrict outbound protocols and tunnels that bypass inspection."
    },
    "dnsSecurity": {
      "controls": [
        "164.308(a)(5)(ii)(B)"
      ],
      "rationale": "Block DNS resolution of malicious and newly registered domains; stop DNS tunneling."
    },
    "sslInspection": {
      "controls": [
        "164.312(e)(1)",
        "164.312(b)"
      ],
      "rationale": "Inspect encrypted traffic so malware and ePHI exfiltration controls work; exempt health and finance sites for privacy."
    },
    "dlpMonitor": {
      "controls": [
        "164.312(b)",
        "164.308(a)(1)(ii)(D)"
      ],
      "rationale": "Monitor-only DLP gives visibility into ePHI in motion without disrupting care workflows."
    },
    "dlpBlock": {
      "controls": [
        "164.312(e)(1)",
        "164.312(a)(1)"
      ],
      "rationale": "Block ePHI identifiers (SSN, MBI, MRN, ICD-10 with diagnosis context, NPI) leaving to unsanctioned destinations."
    },
    "endpointDlp": {
      "controls": [
        "164.312(a)(1)",
        "164.310(d)(1)"
      ],
      "rationale": "Monitor ePHI copied to USB storage, personal cloud sync and printers (device and media controls)."
    },
    "sandbox": {
      "controls": [
        "164.308(a)(5)(ii)(B)"
      ],
      "rationale": "Detonate unknown files before delivery; quarantine high-risk types."
    },
    "aiPromptCapture": {
      "controls": [
        "164.312(b)"
      ],
      "rationale": "Record GenAI prompts so PHI shared with AI tools is auditable."
    }
  },
