  "dlp": {
    "monitorEngines": [
      "PCI",
      "GLBA"
    ],
    "blockRules": [
      {
        "key": "PII",
        "label": "PII",
        "dictionaries": [
          "predefined:SSN",
          "predefined:TIN_LEAKAGE",
          "predefined:USDL_LEAKAGE"
        ],
        "controls": [
          "8.12"
        ]
      },
      {
        "key": "Payment-Cards",
        "label": "Payment-Cards",
        "dictionaries": [
          "predefined:CREDIT_CARD"
        ],
        "controls": [
          "8.12"
        ]
      },
      {
        "key": "Credentials",
        "label": "Credentials",
        "dictionaries": [
          "predefined:CRED_LEAKAGE",
          "custom:SECRETS_KEYS"
        ],
        "expression": "(({CRED_LEAKAGE} > 1) OR ({SECRETS_KEYS} > 0))",
        "why": "Passwords in clear text, private keys and cloud or SaaS access tokens.",
        "controls": [
          "8.12",
          "8.5"
        ]
      },
      {
        "key": "Source-Code",
        "label": "Source-Code",
        "defaultAction": "ALLOW",
        "severity": "RULE_SEVERITY_MEDIUM",
        "why": "Program source (structure and statements together) leaving the organization, for example pasted into AI apps or personal repositories. Monitor by default.",
        "dictionaries": [
          "custom:SRC_SIGNAL",
          "custom:SRC_ANCHOR"
        ],
        "expression": "(({SRC_SIGNAL} > 4) AND ({SRC_ANCHOR} > 0))",
        "controls": [
          "8.12"
        ]
      }
    ],
    "endpointChannels": [
      "REMOVABLE_DRIVE_TRANSFER",
      "PERSONAL_CLOUD_STORAGE",
      "PRINTING"
    ]
