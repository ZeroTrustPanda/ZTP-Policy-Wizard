      "controls": [
        "SI-3",
        "SI-4",
        "SC-7"
      ],
      "rationale": "Malicious code protection and system monitoring."
    },
    "firewallFiltering": {
      "controls": [
        "SC-7",
        "SC-7(5)"
      ],
      "rationale": "Deny network communications traffic by default; allow by exception."
    },
    "dnsSecurity": {
      "controls": [
        "SC-20",
        "SC-21",
        "SI-4"
      ],
      "rationale": "Secure name resolution and detect DNS tunneling."
    },
    "sslInspection": {
      "controls": [
        "SC-8",
        "SC-7(8)",
        "SI-4"
      ],
      "rationale": "Inspect encrypted traffic through managed interfaces."
    },
    "dlpMonitor": {
      "controls": [
        "AU-2",
        "SI-4"
      ],
      "rationale": "Monitor sensitive information flows."
    },
    "dlpBlock": {
      "controls": [
        "AC-4",
        "SC-7(10)"
      ],
      "rationale": "Prevent exfiltration of CUI and PII."
    },
    "endpointDlp": {
      "controls": [
        "MP-7",
        "AC-19"
      ],
      "rationale": "Media use restrictions: removable media, personal cloud and print."
    },
    "sandbox": {
      "controls": [
        "SI-3",
        "SC-44"
      ],
      "rationale": "Detonation chambers for unknown content (SC-44)."
    },
    "aiPromptCapture": {
      "controls": [
        "AU-2",
        "AU-12"
      ],
      "rationale": "Event logging for AI tool use."
    }
