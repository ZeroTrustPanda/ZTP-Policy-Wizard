      "name": "Audit logs are implemented",
      "source": "pci"
    },
    {
      "id": "12.3",
      "name": "Risks to the cardholder data environment are identified",
      "source": "pci"
    },
    {
      "id": "1.2.5",
      "name": "All services, protocols and ports allowed are identified, approved and have a defined business need",
      "source": "pci"
    },
    {
      "id": "6.4.2",
      "name": "An automated technical solution detects and prevents web-based attacks on public-facing web applications",
      "source": "pci"
    },
    {
      "id": "7.2",
      "name": "Access to system components and data is appropriately defined and assigned",
      "source": "pci"
    },
    {
      "id": "8.2.8",
      "name": "Sessions idle for more than 15 minutes require re-authentication",
      "source": "pci"
    },
    {
      "id": "9.4",
      "name": "Media with cardholder data is securely stored, accessed, distributed and destroyed",
      "source": "pci"
    },
    {
      "id": "10.6",
      "name": "Time-synchronization mechanisms support consistent time settings",
      "source": "pci"
    },
    {
      "id": "11.5",
      "name": "Network intrusions and unexpected file changes are detected and responded to",
      "source": "pci"
    },
    {
      "id": "12.2",
      "name": "Acceptable use policies for end-user technologies are defined and implemented",
      "source": "pci"
    }
